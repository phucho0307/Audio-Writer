{
  "name": "@aw/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "lint": "eslint src --ext .ts",
    "test:covers": "npm run build && node --test test/story-covers.test.cjs",
    "test:covers:smoke": "node --use-system-ca test/story-covers.smoke.cjs",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed-stories.ts",
    "db:seed:dark": "dotenv -e ../../.env -- tsx prisma/seed-dark-stories.ts",
    "db:seed:native": "dotenv -e ../../.env -- tsx prisma/seed-native-texts.ts",
    "db:seed:chinese": "dotenv -e ../../.env -- tsx prisma/seed-chinese-stories.ts"
  },
  "dependencies": {
    "@aw/shared": "*",
    "@aws-sdk/client-s3": "^3.1130.0",
    "@hocuspocus/extension-database": "^4.7.1",
    "@hocuspocus/server": "^4.7.1",
    "@hocuspocus/transformer": "^4.7.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.2.0",
    "argon2": "^0.41.1",
    "bullmq": "^6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "nodemailer": "^10.6.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "ws": "^8.22.0",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.7.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.24",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/ws": "^8.18.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
}
