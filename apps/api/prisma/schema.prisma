generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, vector]
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum Role {
  USER
  /// Can act on any story, not just their own. Assigned by hand in the
  /// database - there is deliberately no endpoint that grants it.
  ADMIN
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  handle          String    @unique
  displayName     String
  passwordHash    String? // null for OAuth-only accounts
  /// When the owner proved they read this inbox: a link we emailed, a
  /// password reset, or Google saying so. Null for an email sign-up that has
  /// not clicked its link yet.
  emailVerifiedAt DateTime?
  googleSub       String?   @unique
  avatarUrl       String?
  locale          String    @default("vi")
  role            Role      @default(USER)

  /// A few lines about themselves, shown on their profile. Plain text.
  bio             String?
  /// When the handle was last changed by its owner; changes are spaced out
  /// so a handle cannot be swapped back and forth to impersonate someone.
  handleChangedAt DateTime?

  // Bring-your-own-key: lets heavy users skip the shared free-tier queue.
  // Encrypted at rest by the app layer, never returned to the client.
  byokProvider  String?
  byokKeyCipher String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stories        Story[]
  branches       Branch[]
  contributions  Contribution[]
  sessions       Session[]
  entitlements   Entitlement[]
  renderJobs     RenderJob[]
  unlocks        StoryUnlock[]
  ratings        StoryRating[]
  readsLog       StoryReader[]
  progress       ReadingProgress[]
  follows        StoryFollow[]
  comments       Comment[]
  ledger         LedgerEntry[]
  collaborations BranchCollaborator[]

  @@map("users")
}

// Refresh-token allowlist. Redis holds the hot copy for revocation checks;
// this table is the durable record so a Redis flush does not log everyone out.
model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  rotatedFrom String?   @db.Uuid
  createdAt   DateTime  @default(now())

  @@index([userId, revokedAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Stories: the git-shaped part
// ---------------------------------------------------------------------------

enum StoryStatus {
  DRAFTING
  COMPLETE
  ARCHIVED
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

model Story {
  id          String      @id @default(uuid()) @db.Uuid
  ownerId     String      @db.Uuid
  owner       User        @relation(fields: [ownerId], references: [id])
  title       String
  synopsis    String?
  /// Cover art. Local path in dev, object-store URL in production.
  coverUrl    String?
  /// Source and photographer for a cover selected from a stock library.
  coverCredit Json?
  /// Attribution for a full-text work imported with republication rights.
  /// Ownership of the library record is separate from the literary author.
  textSource  Json?
  genres      String[]
  language    String      @default("vi")
  status      StoryStatus @default(DRAFTING)
  /// Starts private. A story becomes visible only through an explicit publish,
  /// which is also where the fork policy has to be answered.
  visibility  Visibility  @default(PRIVATE)

  // Denormalised for the feed. Recomputed on write, never read-modify-write.
  contributionCount Int @default(0)
  branchCount       Int @default(1)
  wordCount         Int @default(0)
  viewCount         Int @default(0)
  /// Reader ratings, kept as count and sum so the average and the ranking
  /// score come from the row without aggregating story_ratings on every list.
  /// Updated in the same transaction as the rating itself.
  ratingCount       Int @default(0)
  ratingSum         Int @default(0)

  /// Chapters below this depth are readable by anyone, forever. The story
  /// keeps spreading after it is monetised - gating discovery would cap the
  /// story's reach at exactly the moment it starts working.
  freeChapters Int @default(3)

  /// Whether anyone other than the owner may fork this story.
  ///
  /// Null means undeclared, and a story cannot leave PRIVATE while it is - so
  /// publishing forces the writer to answer the question rather than
  /// inheriting a default they never saw. Turning it off later blocks new
  /// forks only; branches that already exist keep working, because retracting
  /// someone's published work is a different and much heavier decision.
  allowForks Boolean?

  /// Credits to unlock everything beyond the free chapters. 0 leaves the
  /// whole story open, which is the default until the writer opts in.
  unlockPrice Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The branch readers land on.
  ///
  /// Normally the root, but a writer revising a published story works on a
  /// copy and promotes it here when it is ready - so the version people read
  /// changes atomically, and the branch it replaced stays as history. Null
  /// means "the root branch", which is every story until someone revises one.
  mainBranchId String? @unique @db.Uuid
  mainBranch   Branch? @relation("MainBranch", fields: [mainBranchId], references: [id], onDelete: SetNull)

  branches Branch[]
  unlocks  StoryUnlock[]
  ratings  StoryRating[]
  readers  StoryReader[]
  card     StoryCard?
  progress ReadingProgress[]
  follows  StoryFollow[]

  @@index([visibility, status, updatedAt])
  @@index([genres], type: Gin)
  @@map("stories")
}

model Branch {
  id      String @id @default(uuid()) @db.Uuid
  storyId String @db.Uuid
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  name   String  @default("main")
  isRoot Boolean @default(false)

  // Copy-on-write forking. `lineage` is the ordered list of ancestor branch ids
  // (root first, excluding self). Reading a forked branch = this branch's own
  // contributions, plus ancestors' contributions up to `forkedAtDepth`.
  // A fork copies zero rows.
  forkedFromBranchId String?  @db.Uuid
  forkedFromBranch   Branch?  @relation("BranchForks", fields: [forkedFromBranchId], references: [id])
  forks              Branch[] @relation("BranchForks")
  forkedAtDepth      Int?
  lineage            String[] @default([])

  /// A working copy, visible only to its owner.
  ///
  /// Revisions start here: the whole point of revising on a copy is that
  /// nobody reads it until it is promoted. Forks are not drafts - a fork is
  /// someone's own story and public from the first word.
  isDraft Boolean @default(false)

  /// Link sharing for the branch's draft room, as in Google Docs: a secret
  /// token, and what anyone who opens it gets. Null access = restricted.
  shareToken String?     @unique
  linkAccess CollabRole?

  headContributionId String? @db.Uuid
  depth              Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Set when this branch is the story's canonical one. See Story.mainBranch.
  mainOf Story? @relation("MainBranch")

  contributions Contribution[]
  scenes        Scene[]
  renderJobs    RenderJob[]
  collaborators BranchCollaborator[]
  draft         DraftDoc?

  @@index([storyId])
  @@index([lineage], type: Gin)
  @@map("branches")
}

enum AuthorType {
  HUMAN
  AI
}

/// IMMUTABLE. Never UPDATE or DELETE a row in this table - that is the whole
/// point of the model. Corrections are new contributions; removals are new
/// branches. Reading a branch is one indexed query ordered by `depth`.
model Contribution {
  id       String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  parentId String?        @db.Uuid
  parent   Contribution?  @relation("Chain", fields: [parentId], references: [id])
  children Contribution[] @relation("Chain")

  depth Int

  /// Chapter heading. Optional - a writer committing a paragraph mid-session
  /// should not be forced to name it, so the contents page falls back to the
  /// opening line.
  title String?

  authorId   String?    @db.Uuid
  author     User?      @relation(fields: [authorId], references: [id])
  authorType AuthorType

  // TipTap/ProseMirror document for THIS chunk only, not the whole story.
  content   Json
  textPlain String
  wordCount Int

  // Provenance for AI turns - which driver and model actually produced this.
  modelProvider String?
  modelName     String?

  createdAt DateTime @default(now())

  audio    AudioClip[]
  comments Comment[]

  @@unique([branchId, depth])
  @@index([branchId, depth])
  @@map("contributions")
}

/// Narration for one chapter, cached.
///
/// Kept out of `contributions` because that table is immutable - and because
/// audio is derived data that can be regenerated, deleted, or produced in
/// several voices without the chapter itself changing.
///
/// Unique on (contribution, voice) so asking twice costs one synthesis. That
/// matters more than usual here: the free TTS tier is metered per request.
enum CollabRole {
  /// May type in the draft.
  EDITOR
  /// May watch it being written, cursor included, but not change it.
  VIEWER
}

/// Who, besides the owner, may open a branch's draft room.
///
/// Forking is how a reader takes a story somewhere else; this is the opposite -
/// several people writing the same branch together. Kept separate from the
/// branch's own ownership so revoking access is one row, and so a viewer can be
/// let in to watch without being able to type.
model BranchCollaborator {
  id       String     @id @default(uuid()) @db.Uuid
  branchId String     @db.Uuid
  branch   Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId   String     @db.Uuid
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     CollabRole @default(EDITOR)
  /// Joined through the share link rather than invited by name - so turning
  /// the link off, or resetting it, takes this access away again.
  viaLink  Boolean    @default(false)

  invitedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@unique([branchId, userId])
  @@index([userId])
  @@map("branch_collaborators")
}

/// The live, shared draft of a branch's next chapter.
///
/// A CRDT document rather than a row of text: several writers (and the model)
/// type into it at once, and every client merges the same edits into the same
/// result without a server deciding who won. `state` is the Yjs document
/// encoded as a single update - the whole history collapsed into one blob,
/// which is what Yjs hands back when asked to persist.
///
/// This is deliberately *not* a Contribution. Contributions are immutable and
/// are what a branch is made of; this is the scratch space before one exists.
/// Committing turns the draft into a Contribution and clears the room.
model DraftDoc {
  id       String @id @default(uuid()) @db.Uuid
  branchId String @unique @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  /// Yjs state, as produced by Y.encodeStateAsUpdate.
  state Bytes

  /// Bumped on every store. Lets a reader tell whether anything changed without
  /// decoding the document, and makes a stale write obvious.
  version Int @default(0)

  /// Denormalised so the dashboard can list drafts without loading the CRDT.
  title     String?
  wordCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("draft_docs")
}

/// The five the platform is built around. Stored as slugs on Story.genres so
/// a story can still carry free-form tags alongside them.
enum Genre {
  /// kinh dị
  HORROR
  /// giật gân, hồi hộp
  THRILLER
  /// ngôn tình
  ROMANCE
  /// hành động
  ACTION
  /// ngoại tình
  INFIDELITY
}

enum SourceKind {
  /// Free audio-story sites: nghetruyenma.net, audioma.vn and the like.
  AUDIO_SITE
  /// Narrator channels, where the performance is the draw.
  CHANNEL
  /// Licensed audiobook apps: Fonos, Voiz FM, Waka.
  APP
  /// Out of copyright, and therefore quotable.
  PUBLIC_DOMAIN
}

/// Where Vietnamese audio fiction actually lives, for writers to study.
///
/// Links and a line on what each is good for - deliberately not their text.
/// These are commercial catalogues; copying their stories into a product that
/// sells generated ones is the kind of shortcut that ends in a takedown. What
/// gets indexed is our own craft notes, written from reading them, which is
/// what a human studying the genre would produce anyway.
model ReferenceSource {
  id     String     @id @default(uuid()) @db.Uuid
  slug   String     @unique
  name   String
  url    String
  kind   SourceKind
  /// Which of the five this is worth studying for.
  genres Genre[]
  /// One line: what a writer gets here that they will not get elsewhere.
  note   String
  /// Roughly how much is there, when the site says. Free text on purpose.
  scale  String?

  craftNotes CraftNote[]
  createdAt  DateTime    @default(now())

  @@map("reference_sources")
}

enum CraftKind {
  /// A recurring device: the thing readers of this genre came for.
  TROPE
  /// How a chapter is shaped: where the turn goes, where to cut.
  BEAT
  /// Ways in. The first paragraph does most of the work in serial fiction.
  OPENING
  /// Reveals, and the cost of placing one too early.
  TWIST
  /// Places that carry the genre: a flooded alley, a Tết dinner, a night shift.
  SETTING
}

/// Our own writing about how these genres work.
///
/// This is the corpus the model retrieves from. Written here rather than
/// scraped, so it can be licensed, corrected and deleted - and so a retrieved
/// passage is a note about craft rather than somebody's chapter.
model CraftNote {
  id    String    @id @default(uuid()) @db.Uuid
  kind  CraftKind
  genre Genre
  title String
  /// The note itself. A few sentences a writer can act on.
  body  String

  /// What reading suggested it. Attribution, not a licence to copy.
  sourceId String?          @db.Uuid
  source   ReferenceSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([genre, kind])
  @@map("craft_notes")
}

model AudioClip {
  id             String       @id @default(uuid()) @db.Uuid
  contributionId String       @db.Uuid
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  voice      String
  provider   String
  url        String
  durationMs Int?
  bytes      Int?

  /// sha256 of the text, the voice and the driver fingerprint.
  ///
  /// The file is addressed by what is in it rather than by which row asked for
  /// it, so identical text narrated in the same voice is stored and paid for
  /// once. That matters because `revise` copies every chapter into new rows
  /// with new ids: without this, promoting a revision orphans every clip on
  /// the story and re-bills the lot to fix one typo.
  ///
  /// Nullable only for clips written before this existed.
  contentHash String?

  createdAt DateTime @default(now())

  @@unique([contributionId, voice])
  @@index([contributionId])
  @@index([contentHash])
  @@map("audio_clips")
}

// ---------------------------------------------------------------------------
// Media pipeline
// ---------------------------------------------------------------------------

model Scene {
  id       String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  ord         Int
  text        String
  imagePrompt String?
  imageUrl    String?
  audioUrl    String?
  durationMs  Int?

  // Sentence-level narration timings. Subtitle cues are derived from these,
  // so no forced-alignment pass is needed.
  cues Json?

  createdAt DateTime @default(now())

  @@unique([branchId, ord])
  @@map("scenes")
}

enum RenderKind {
  AUDIO
  VIDEO_PREVIEW
  VIDEO_FULL
}

enum RenderStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
  CANCELLED
}

model RenderJob {
  id       String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  /// Null for narration asked for by a signed-out reader. Public stories are
  /// readable without an account, and narration is part of reading them.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  /// Set for per-chapter narration; null for whole-branch and video renders,
  /// which this table was originally shaped for. Deliberately not a foreign
  /// key: the job row is a record of work done, and should outlive a chapter
  /// that gets deleted.
  contributionId String? @db.Uuid
  voice          String?

  kind   RenderKind
  status RenderStatus @default(QUEUED)

  // Current pipeline stage, e.g. "scenes" | "tts" | "concat" | "images" | "render".
  // Every worker checks this before doing work so a redelivered Kafka message
  // is a no-op rather than a second bill.
  stage    String?
  progress Int     @default(0)

  // Derived from (branchId, headContributionId, kind). Makes at-least-once
  // delivery safe.
  idempotencyKey String @unique

  outputUrl String?
  costCents Int     @default(0)
  error     String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@map("render_jobs")
}

// ---------------------------------------------------------------------------
// Money
// ---------------------------------------------------------------------------

enum EntitlementKind {
  VIDEO_EXPORT
  NEURAL_VOICE
  /// Extra AI turns beyond the free daily allowance.
  AI_CREDITS
  /// Spent unlocking other writers' paid chapters.
  READ_CREDITS
}

model Entitlement {
  id     String          @id @default(uuid()) @db.Uuid
  userId String          @db.Uuid
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   EntitlementKind

  // Credit-pack model: granted many, consumed one render at a time.
  granted  Int
  consumed Int @default(0)

  orderId   String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
  @@map("entitlements")
}

/// One reader has paid for one story, permanently. Unique on (story, user) so
/// a double-click or a retried request cannot charge twice.
/// What AI search matches against: a short description of the story written
/// by a model from its text - summary, plot motifs, mood, kind of ending -
/// plus that description embedded. One row per story.
///
/// `embedding` (pgvector) and `search` (full-text, accent-folded) are created
/// by the migration and used through raw SQL, as Prisma has no type for them.
model StoryCard {
  storyId   String   @id @db.Uuid
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  summary   String
  /// Concrete plot motifs: "chồng ngoại tình", "tiểu tam mang thai".
  tropes    String[]
  /// From a fixed list, so a query can match them exactly.
  moods     String[]
  /// HE (happy), SE (sad), OE (open) or UNKNOWN.
  ending    String
  keywords  String[]
  /// The text that was embedded and full-text indexed.
  document  String
  /// Model that wrote the card, and the prompt version. A change means the
  /// card is regenerated; "stale" marks one whose story has changed.
  model     String
  version   Int
  stale     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("story_cards")
}

/// One reader's stars for one story. Changing your mind overwrites it.
model StoryRating {
  id        String   @id @default(uuid()) @db.Uuid
  storyId   String   @db.Uuid
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1 to 5.
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storyId, userId])
  @@index([userId])
  @@map("story_ratings")
}

/// That a signed-in reader has opened at least one chapter of a story.
/// Rating requires it: stars from someone who never read the story say
/// nothing about the story.
model StoryReader {
  storyId     String   @db.Uuid
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstReadAt DateTime @default(now())

  @@id([storyId, userId])
  @@index([userId])
  @@map("story_readers")
}

/// Where a signed-in reader stopped in a story: which chapter, and how far
/// into its narration. One row per reader per story - the newest position
/// wins - so "nghe tiếp" picks up on another device.
model ReadingProgress {
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId String @db.Uuid
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  /// The branch being read; null is the story's main line.
  branchId    String? @db.Uuid
  /// 0-based chapter.
  depth       Int
  /// Seconds into that chapter's narration; 0 when only reading.
  positionSec Int     @default(0)

  /// When the reader was there, by their device's clock (never in the
  /// future). Two devices are merged on this, so an old phone coming back
  /// online does not rewind what was heard since on the laptop.
  updatedAt DateTime

  @@id([userId, storyId])
  @@index([userId, updatedAt])
  @@map("reading_progress")
}

/// A reader following a story.
///
/// New chapters are found by comparison, not by fan-out: the story's chapter
/// count against what this follower had seen. Publishing a chapter writes
/// nothing per follower, so a story with a hundred thousand followers costs
/// the same to update as one with none.
model StoryFollow {
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId String @db.Uuid
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  /// Chapters the story had when this follower last opened it.
  seenChapters Int      @default(0)
  createdAt    DateTime @default(now())

  @@id([userId, storyId])
  @@index([storyId])
  @@map("story_follows")
}

/// A reader's comment on one chapter.
///
/// Attached to the chapter row itself rather than to "story + chapter
/// number": chapter 5 of a fork is a different text from chapter 5 of the
/// original, and a branch's inherited chapters are the same rows as its
/// parent's, so their comments are shared exactly where the text is.
model Comment {
  id             String       @id @default(uuid()) @db.Uuid
  contributionId String       @db.Uuid
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime @default(now())

  @@index([contributionId, createdAt])
  @@index([userId, createdAt])
  @@map("comments")
}

model StoryUnlock {
  id        String   @id @default(uuid()) @db.Uuid
  storyId   String   @db.Uuid
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pricePaid Int
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([userId, createdAt])
  @@map("story_unlocks")
}

enum LedgerKind {
  /// A reader unlocked this writer's story.
  UNLOCK_EARNING
  /// Writer withdrew a balance. Negative amount.
  PAYOUT
  /// Manual correction - refunds, disputes.
  ADJUSTMENT
}

/// Append-only record of what a writer has earned.
///
/// A balance column would be a running total someone eventually has to
/// reconcile; a ledger is summed on demand and can always be explained line by
/// line, which is what you want the first time a writer disputes a number.
model LedgerEntry {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      LedgerKind
  /// Credits. Positive is earned, negative is paid out.
  amount    Int
  storyId   String?    @db.Uuid
  /// Free-text explanation shown to the writer.
  note      String?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Transactional outbox - the bridge from Postgres to Kafka/Redpanda.
// Written in the same transaction as the state change it describes, so a job
// can never exist without its event, or an event without its job.
// ---------------------------------------------------------------------------

model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  aggregateId String    @db.Uuid
  topic       String
  payload     Json
  publishedAt DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([publishedAt, id])
  @@map("outbox_events")
}
