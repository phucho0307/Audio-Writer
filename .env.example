# ---- Database ----
DATABASE_URL="postgresql://aw:aw_dev_password@localhost:5432/audio_writer?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me"
# Also signs the short-lived OAuth handshake cookie that carries the `state`
# nonce and PKCE verifier. Change it and any sign-in mid-flight fails; that is
# harmless (the user retries) but it is why this is not just a spare key.
JWT_REFRESH_SECRET="change-me-differently"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Encrypts user-supplied BYOK API keys at rest. 32 bytes, base64url.
BYOK_ENCRYPTION_KEY="change-me-32-bytes"

# When true, unauthenticated requests resolve to the seeded dev account so
# the app runs without Google credentials configured. Must be false in prod.
AUTH_DEV_USER="true"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Exposes the credit-granting stand-ins for checkout (/api/ai/quota/grant and
# /api/me/credits/grant). They hand out PAID credits with no payment, so this
# must never be true in production - the routes 404 without it.
DEV_ENDPOINTS="true"

# ---- Rate limit ----
# Per minute, per caller - the signed-in user where there is one, else IP.
# Counters live in Redis, so replicas share them and a deploy does not hand
# everyone a fresh allowance. The tighter limits for sign-in and for AI live in
# src/throttler/tiers.ts: decorators are evaluated before this file is read, so
# they cannot come from here without silently being ignored.
RATE_DEFAULT_PER_MIN="120"

# Failed refresh attempts allowed per IP before a 30-minute lock, counted
# separately from the traffic limit above. See auth/auth-failure.limiter.ts.
# 5 per 10 minutes, hardcoded for the same reason the tiers are.

# Number of proxy hops in front of the API, or empty when there are none.
# Empty in local dev. Behind one load balancer, "1". Leaving it empty in
# production makes every caller share one rate-limit bucket; setting it with no
# proxy in front lets callers forge X-Forwarded-For and escape the limit.
TRUST_PROXY=""

# ---- LLM drivers (free tiers) ----
# Order is the failover chain. First driver that is configured and not
# rate-limited wins.
LLM_DRIVER_CHAIN="gemini,groq,openrouter"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# Self-throttle just under the provider ceiling so we 429 ourselves, not them.
LLM_GLOBAL_RPM="12"
LLM_USER_RPM="3"
LLM_USER_DAILY="60"

# ---- AI quota ----
AI_FREE_DAILY="3"
AI_QUOTA_TZ="Asia/Ho_Chi_Minh"

# ---- Paid chapters ----
# Writer's cut of every unlock, as a percentage. The rest is the platform's.
WRITER_REVENUE_SHARE="70"

# ---- Text to speech ----
# Shares the Gemini key. Its own per-model daily quota, separate from text.
TTS_MODEL="gemini-2.5-flash-preview-tts"

# Narration runs on a queue rather than inside the request. Set false on an
# instance that should only serve HTTP; one process can safely do both, which
# is what development does.
RUN_WORKER="true"

# How many chapters may be synthesised at once, and the ceiling on how fast the
# pool may call the provider. The limiter is enforced at the worker rather than
# at the door, so it holds no matter how many requests were accepted.
# Narrate the free chapters as soon as a story is published, rather than when
# somebody presses play. A chapter takes between half a minute and three and a
# half minutes to synthesise, so meeting the synthesiser is what makes
# narration feel slow; rendering ahead of the reader is how audiobook platforms
# avoid the problem entirely. How far it goes is decided by the paywall, not by
# a number here - pre-rendering runs with no signed-in user, so it renders
# exactly what an anonymous visitor can read.
PRERENDER_ON_PUBLISH="true"

NARRATION_CONCURRENCY="2"
TTS_RPM="10"

# Bitrate for narration. 64k mono AAC is transparent for speech and about a
# tenth of the raw PCM the provider returns.
# Deadman switch on a single synthesis, not a latency budget - nobody waits on
# the request any more, so patience is free and an impatient abort costs a
# re-billed synthesis. Chapters have been seen taking anywhere from 29 seconds
# to over two minutes.
TTS_TIMEOUT_MS="300000"

AUDIO_BITRATE="64k"

# Path to an ffmpeg binary. Empty uses the one bundled by ffmpeg-static, so a
# fresh clone needs no system install. With no ffmpeg at all, audio is stored
# as uncompressed WAV rather than failing.
FFMPEG_PATH=""

# ---- Audio storage ----
# Empty R2_BUCKET keeps audio on the local disk, which is the default and works
# with no credentials - but only while the API and the web app share a
# filesystem. Filling these in moves narration to R2 with no code change.
# R2 rather than S3 because audio is almost all egress, and R2 charges none.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Public base URL of the bucket or its custom domain, no trailing slash.
R2_PUBLIC_BASE=""


# ---- App ----
NODE_ENV="development"
API_PORT="4000"
WEB_ORIGIN="http://localhost:3000"
