# ---- Database ----
DATABASE_URL="postgresql://aw:aw_dev_password@localhost:5432/audio_writer?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me"
# Also signs the short-lived OAuth handshake cookie that carries the `state`
# nonce and PKCE verifier. Change it and any sign-in mid-flight fails; that is
# harmless (the user retries) but it is why this is not just a spare key.
JWT_REFRESH_SECRET="change-me-differently"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Encrypts user-supplied BYOK API keys at rest. 32 bytes, base64url.
BYOK_ENCRYPTION_KEY="change-me-32-bytes"

# When true, unauthenticated requests resolve to the seeded dev account so
# the app runs without Google credentials configured. Must be false in prod.
AUTH_DEV_USER="true"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Exposes the credit-granting stand-ins for checkout (/api/ai/quota/grant and
# /api/me/credits/grant). They hand out PAID credits with no payment, so this
# must never be true in production - the routes 404 without it.
DEV_ENDPOINTS="true"

# ---- LLM drivers (free tiers) ----
# Order is the failover chain. First driver that is configured and not
# rate-limited wins.
LLM_DRIVER_CHAIN="gemini,groq,openrouter"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# Self-throttle just under the provider ceiling so we 429 ourselves, not them.
LLM_GLOBAL_RPM="12"
LLM_USER_RPM="3"
LLM_USER_DAILY="60"

# ---- AI quota ----
AI_FREE_DAILY="3"
AI_QUOTA_TZ="Asia/Ho_Chi_Minh"

# ---- Paid chapters ----
# Writer's cut of every unlock, as a percentage. The rest is the platform's.
WRITER_REVENUE_SHARE="70"

# ---- Text to speech ----
# Shares the Gemini key. Its own per-model daily quota, separate from text.
TTS_MODEL="gemini-2.5-flash-preview-tts"

# ---- App ----
NODE_ENV="development"
API_PORT="4000"
WEB_ORIGIN="http://localhost:3000"
